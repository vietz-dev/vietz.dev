---
import Layout from "../layouts/Layout.astro";
import Moin from "../components/Moin.astro";

const facts = [
  { label: "location", value: "Münster, DE" },
  { label: "focus", value: "Full-Stack" },
  { label: "employer", value: "dreifach.ai" },
];
---

<Layout>
  <section class="site-container page-section home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <h1 id="home-title" class="home-title">Justin Vietz</h1>
      <p class="home-role">Full-stack developer in Münster, Germany.</p>
      <p class="home-summary">
        I build things for the web — from frontend interfaces that feel right to backend systems that stay out of the way.
      </p>
      <div class="home-actions">
        <a class="home-primary-link" href="/projects">Explore my projects <span aria-hidden="true">↗</span></a>
        <a class="home-secondary-link" href="/blog">Read my writing</a>
      </div>
      <a class="home-email" href="mailto:justin@vietz.dev">justin@vietz.dev</a>
    </section>

    <Moin />

    <div class="home-divider"></div>

    <section class="home-intro">
      <div class="home-copy">
        <p>
          Full stack, end to end — TypeScript, Go, React, Angular, Svelte, and whatever infrastructure it takes to ship and keep it running.
          The framework is a means to an end. What I actually care about is maintainable code, reproducible infrastructure, and staying curious.
        </p>
        <p>
          On this site you'll find my <a class="text-link" href="/projects">projects</a> and a
          <a class="text-link" href="/blog">blog</a> where I write about what I'm building and thinking about.
        </p>
      </div>
    </section>

    <section class="facts-grid" aria-label="Quick facts">
      {
        facts.map((fact) => (
          <div class="fact-item">
            <div class="fact-label">{fact.label}</div>
            <div class="fact-value">{fact.value}</div>
          </div>
        ))
      }
    </section>
  </section>
</Layout>

<style>
  .home-page {
    padding-top: 48px;
  }

  .home-hero {
    padding-bottom: 48px;
  }

  .home-title {
    margin: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: clamp(42px, 8vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  .home-role {
    margin: 14px 0 0;
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 500;
    color: var(--fg);
  }

  .home-summary {
    max-width: 58ch;
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .home-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .home-primary-link,
  .home-secondary-link,
  .home-email {
    width: fit-content;
    font-family: "IBM Plex Mono", monospace;
    font-size: 14px;
    text-underline-offset: 3px;
  }

  .home-primary-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px;
    border-radius: 4px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }

  .home-primary-link:hover {
    background: var(--accent);
  }

  .home-secondary-link,
  .home-email {
    color: var(--fg);
  }

  .home-email {
    display: inline-block;
    margin-top: 20px;
  }

  .home-primary-link:focus-visible,
  .home-secondary-link:focus-visible,
  .home-email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .home-divider {
    border-top: 1px solid var(--border);
    margin-bottom: 48px;
  }

  .home-intro {
    margin-bottom: 56px;
  }

  .home-copy {
    display: grid;
    gap: 16px;
  }

  .home-copy p {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--fg-muted);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--border);
  }

  .fact-item {
    background: var(--bg-card);
    padding: 18px 22px;
  }

  .fact-label {
    margin-bottom: 6px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .fact-value {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .home-page {
      padding-top: 32px;
    }

    .home-hero {
      padding-bottom: 40px;
    }
  }
</style>
